{
  "dataset_version": "semantic-theory-1.0",
  "provenance": "语料取自 patents.json（2026-11-04 自 Google Patents 逐字核验）；候选输出为冻结的模拟业务输出，有对有错；label 为细则答案，被测流程不得读取。对照 rsi-lab：features/documents ≈ 作业字段，candidate_output ≈ 阅卷 Agent 结论，label ≈ policy.py 算出的细则答案，score.py ≈ audit.py 对账。",
  "label_convention": "expected_statuses/expected_sections/expected_conclusion 由 policy.py 记载的细则从原文事实推导；expected_verdict 是对该候选输出的语义验收裁决（acceptable/needs_revision/pending_adjudication）；violations 引用六维键名（terms_objects/structure_relations/logic_constraints/context_reference/functions_effects/evaluation_expression）。",
  "usage": "usage=train 的案例用于日常回归；usage=anchor 的案例不参与任何迭代调优，只用于对账。",
  "cases": [
    {
      "id": "T01",
      "usage": "train",
      "patents": ["US4968168A"],
      "skill_under_test": "patent-evidence-alignment",
      "trap": "同一文献中互斥实施例被并成同一技术方案",
      "cutoff": "2026-10-19",
      "features": [
        {"id": "F1", "text": "中空杆与中间管通过外螺纹(522)与螺纹孔(321)配合，把旋转运动变换为有限的轴向位移"},
        {"id": "F2", "text": "中空杆下端设螺旋条(421)，沿中间管的螺旋槽(321)滑动，把旋转运动变换为有限的轴向位移"}
      ],
      "documents": [{"id": "US4968168A", "section_ids": ["US4968168A:desc-intermediate", "US4968168A:desc-helical"]}],
      "candidate_output": {
        "conclusion": "potential_novelty_risk",
        "evidence": [
          {"feature_id": "F1", "status": "disclosed", "section_id": "US4968168A:desc-intermediate", "quote": "one end 32 on which is disposed a female thread 321 for accommodating the male thread 522 on the hollow rod 5", "scheme_id": "scheme1"},
          {"feature_id": "F2", "status": "disclosed", "section_id": "US4968168A:desc-helical", "quote": "a helical bar 421 protruding at its lower outer end so as to slide along helical slot 321 of the intermediate tube 20", "scheme_id": "scheme1"}
        ],
        "same_scheme_basis": "两个实施例都是把旋转变换为轴向位移的传动结构，属于同一发明构思，合并为同一方案判断。",
        "self_verdict": "acceptable",
        "notes": "两段原文分别支持两个要素，合并后构成完整披露。"
      },
      "label": {
        "expected_statuses": {"F1": "disclosed", "F2": "disclosed"},
        "expected_sections": {"F1": "US4968168A:desc-intermediate", "F2": "US4968168A:desc-helical"},
        "expected_scheme_map": {"F1": "emb-thread", "F2": "emb-helical"},
        "expected_conclusion": "insufficient_evidence",
        "expected_verdict": "needs_revision",
        "violations": [
          {"dimension": "context_reference", "issue": "螺纹传动与螺旋槽传动分属两个互斥实施例，被并入同一 scheme_id"},
          {"dimension": "structure_relations", "issue": "同一方案确认缺失：没有任何一个实施例同时包含两个传动结构"}
        ]
      }
    },
