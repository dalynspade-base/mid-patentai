# Copy to .env. Keep .env private and out of version control.
# Online retrieval uses Patsnap. Model assistance is optional.
# Optional: local patent-platform MCP config file. Default: ~/Downloads/mcp.json.
# PATENT_PLATFORM_MCP_CONFIG=C:/path/to/mcp.json
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# v1.2 RSI 的独立本地评分模型（仅在真实 RSI 运行时需要）
RSI_RUBRIC_BASE_URL=
RSI_RUBRIC_MODEL=
RSI_RUBRIC_API_KEY=
