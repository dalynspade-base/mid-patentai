# Copy to .env. Keep .env private and out of version control.
# Google Patents is the default. Model assistance is optional.
# Free Google Patents endpoint. The optional legacy entry is https://www.google.com/patents/.
GOOGLE_PATENTS_ENTRY_URL=https://patents.google.com/
# Optional: local patent-platform MCP config file. Default: ~/Downloads/mcp.json.
# PATENT_PLATFORM_MCP_CONFIG=C:/path/to/mcp.json
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
